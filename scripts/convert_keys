#!/usr/bin/env python3
"""Batch convert Ed25519 .pem keys (private or public) into base64-encoded raw keys.

Usage:
    python convert_keys.py [folder]

If no folder is provided, defaults to "./keys".
For each .pem file:
- If it contains an Ed25519 private key, exports the raw private key (32 bytes).
- If it contains an Ed25519 public key, exports the raw public key (32 bytes).

A .b64 file is written next to each .pem file with the base64-encoded raw key.
"""

from __future__ import annotations

import base64
import sys
from pathlib import Path

from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import ed25519


def convert_pem_to_b64(path: Path) -> tuple[str, str]:
    """Convert a PEM Ed25519 key (private or public) into a base64 raw key string.

    The function tries to load the file as an Ed25519 private key first. If that
    fails, it tries to load it as an Ed25519 public key.

    Args:
        path: Path to the PEM file.

    Returns:
        A tuple (kind, b64_string) where:
        - kind: "private" or "public"
        - b64_string: Base64-encoded raw Ed25519 key (32 bytes).

    Raises:
        ValueError: If the file is not a valid Ed25519 private or public key.
    """
    data = path.read_bytes()

    # Try private key first
    try:
        private_key = serialization.load_pem_private_key(data, password=None)
        if isinstance(private_key, ed25519.Ed25519PrivateKey):
            raw = private_key.private_bytes(
                encoding=serialization.Encoding.Raw,
                format=serialization.PrivateFormat.Raw,
                encryption_algorithm=serialization.NoEncryption(),
            )
            return "private", base64.b64encode(raw).decode("utf-8")
    except Exception:  # noqa: BLE001, S110
        # Ignore and try public key
        pass

    # Try public key
    try:
        public_key = serialization.load_pem_public_key(data)
        if isinstance(public_key, ed25519.Ed25519PublicKey):
            raw = public_key.public_bytes(
                encoding=serialization.Encoding.Raw,
                format=serialization.PublicFormat.Raw,
            )
            return "public", base64.b64encode(raw).decode("utf-8")
    except Exception:  # noqa: BLE001, S110
        # Will fall through to error below
        pass

    msg = f"{path} is not a valid Ed25519 private or public PEM key."
    raise ValueError(msg)


def main(folder: str) -> None:
    """Convert all .pem files in a folder into .b64 base64 raw Ed25519 keys.

    Args:
        folder: Folder to scan for .pem files.
    """
    base_path = Path(folder)
    if not base_path.exists():
        print(f"❌ Folder not found: {base_path}")
        sys.exit(1)

    pem_files = list(base_path.glob("*.pem"))
    if not pem_files:
        print(f"⚠️ No .pem files found in {base_path}")
        return

    print(f"🔎 Found {len(pem_files)} key(s) in {base_path}…\n")

    for pem in pem_files:
        try:
            kind, b64_value = convert_pem_to_b64(pem)
            out_path = pem.with_suffix(".b64")
            out_path.write_text(b64_value)
            print(f"✅ {pem.name} ({kind}) -> {out_path.name}")
        except Exception as exc:  # noqa: BLE001
            print(f"❌ Error processing {pem.name}: {exc}")

    print("\n✨ Done.")


if __name__ == "__main__":
    folder_arg = sys.argv[1] if len(sys.argv) > 1 else "./keys"
    main(folder_arg)
